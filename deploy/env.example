# 复制到服务器的 /etc/innate-studio.env，填上真实的 Key，然后 chmod 600。不要提交到仓库。
# 写在这里的 Key 在「管理」里只显示头尾，不能在页面上改或清除。
ARK_API_KEY=
DOUBAO_SPEECH_API_KEY=
MINIMAX_CN_API_KEY=
AIHUBMIX_API_KEY=
# 以下三项只用来查各账户的余额，可以不填。
AIHUBMIX_MANAGE_KEY=
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 火山引擎 TOS：素材分享和模型参考视频直链都用它。
# Bucket 必须已在控制台创建（程序不会创建）；PATH 是对象前缀，可以是空字符串。
INNATE_STUDIO_VOLC_TOS_ACCESS_KEY_ID=
INNATE_STUDIO_VOLC_TOS_ACCESS_KEY=
INNATE_STUDIO_VOLC_TOS_BUCKET=
INNATE_STUDIO_VOLC_TOS_PATH=
# 可选，默认 cn-beijing / tos-cn-beijing.volces.com。
INNATE_STUDIO_VOLC_TOS_REGION=
INNATE_STUDIO_VOLC_TOS_ENDPOINT=
# 可选，给 Bucket 配置的公开访问域名（必须 https）。不填则使用 Bucket 默认公网域名。
INNATE_STUDIO_VOLC_TOS_PUBLIC_BASE_URL=

# RunningHub：ComfyUI 云工作流（海螺 H3 人物替换等）。它是一组 Key，按并发和账户余额路由，
# 所以 Key 不写在这里，而是给一个 JSON 文件的路径（文件格式见 deploy/runninghub-keys.example）。
RUNNINGHUB_KEYS_FILE=
# 临时排查时，只有一个 Key 也可以直接给（等价于一行 JSON 数组）。
# RUNNINGHUB_API_KEY=
# RunningHub 有两个站点：国内站 runninghub.cn、海外站 runninghub.ai。两边的账号、Key、工作流 id 不通用，
# 所以 Key 文件里每个 Key 要写 site（ai / cn）。文件里没写 site 的按这里配的默认站点算，默认 cn。
# RUNNINGHUB_SITE=cn
# 所有 Key 都强制走同一个自定义域名（调试、自建代理时用），平时不要配。
# RUNNINGHUB_BASE_URL=
# 所有 Key 都占满时，提交最多等多久再报错（毫秒），默认 15000。
# RUNNINGHUB_QUEUE_WAIT_MS=15000
# 账户余额：/uc/openapi/accountStatus 会带回每个 Key 的 remainCoins（RH 币），管理面板里能看，
# 挑 Key 时也优先用余额多的，让各账号余额慢慢趋近。设 0 关掉余额路由，改回按并发轮转。
# RUNNINGHUB_ROUTE_BY_COINS=0
# 后台多久问一次平台状态（毫秒，默认 60000）。设 0 则只在打开管理面板、提交任务时问。
# RUNNINGHUB_COINS_REFRESH_MS=60000
# 一批并发提交里，刚派过单的 Key 先虚拟扣掉多少币，用来把请求摊开（默认 1，不是精确记账）。
# RUNNINGHUB_ROUTE_SPEND=1
# 每个接进来的工作流要有自己的工作流 id（在 RunningHub 上「导出 API」之后能拿到）。
# 变量名是 RUNNINGHUB_WORKFLOW_ 加上登记表里的大写 key，横线换成下划线。
# 两个站点共用同一个 id 时写这一行就够了：
# RUNNINGHUB_WORKFLOW_HAILUO_H3_SWAP=
# 两个站点各自一个 id 时，按站点分开写（上面的通用变量不要同时配，会盖掉分站的值）：
# RUNNINGHUB_WORKFLOW_HAILUO_H3_SWAP_CN=
# RUNNINGHUB_WORKFLOW_HAILUO_H3_SWAP_AI=
